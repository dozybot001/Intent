# Non-secret runtime identity. Release SHA and package version are injected
# from the verified manifest by deploy/inthub/remote-release.sh.
INTHUB_DOMAIN=inthub.example.com

# Generate the PostgreSQL password with a cryptographically secure source.
# CLI credentials are issued per IntHub account after GitHub registration.
INTHUB_POSTGRES_PASSWORD=replace-with-random-hex
INTHUB_POSTGRES_DB=inthub
INTHUB_POSTGRES_USER=inthub

# Register one public GitHub App for the platform and select "Any account".
# It needs no webhook and no repository or account permissions. These
# credentials identify the platform; they are not a user allowlist.
INTHUB_GITHUB_CLIENT_ID=replace-with-github-app-client-id
INTHUB_GITHUB_CLIENT_SECRET=replace-with-github-app-client-secret
INTHUB_SESSION_TTL_SECONDS=604800

INTHUB_MAX_BODY_BYTES=16777216
INTHUB_LOG_LEVEL=INFO
