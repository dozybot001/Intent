# Non-secret deployment identity
INTHUB_RELEASE=replace-with-git-sha
INTHUB_PACKAGE_VERSION=0.0.0
INTHUB_DOMAIN=inthub.example.com
INTHUB_BIND_PORT=7250

# Generate both values with a cryptographically secure random source. The API
# token setting is the lowercase SHA-256 digest, not the browser/CLI token.
INTHUB_API_TOKEN_SHA256=replace-with-64-char-sha256
INTHUB_POSTGRES_PASSWORD=replace-with-random-hex
INTHUB_POSTGRES_DB=inthub
INTHUB_POSTGRES_USER=inthub

# Register a GitHub App with this user authorization callback URL:
# https://<INTHUB_DOMAIN>/api/v1/auth/github/callback
# Use stable numeric GitHub user IDs here, comma-separated. Keep one ID while
# this deployment still exposes one owner's unscoped project history.
INTHUB_GITHUB_CLIENT_ID=replace-with-github-app-client-id
INTHUB_GITHUB_CLIENT_SECRET=replace-with-github-app-client-secret
INTHUB_GITHUB_ALLOWED_USER_IDS=replace-with-numeric-github-user-id
INTHUB_SESSION_TTL_SECONDS=604800

INTHUB_MAX_BODY_BYTES=16777216
INTHUB_LOG_LEVEL=INFO
