# Runtime configuration. App/database image digests, release identity, slot,
# and migration state are injected by the trusted server release entry and
# must not be duplicated in this file.
INTHUB_DOMAIN=inthub.example.com

# Generate the PostgreSQL password with a cryptographically secure source.
# CLI credentials remain scoped to the local product account after Tenon login.
INTHUB_POSTGRES_PASSWORD=replace-with-random-hex
INTHUB_POSTGRES_DB=inthub
INTHUB_POSTGRES_USER=inthub

# Register an independent confidential web client through Tenon's operator CLI.
# Exact callback: https://inthub.tenon.asia/api/v1/auth/tenon/callback
INTHUB_TENON_CLIENT_ID=replace-with-tenon-client-id
INTHUB_TENON_CLIENT_SECRET=replace-with-tenon-client-secret
INTHUB_SESSION_TTL_SECONDS=900


INTHUB_MAX_BODY_BYTES=16777216
INTHUB_LOG_LEVEL=INFO
