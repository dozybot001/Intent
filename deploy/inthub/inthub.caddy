inthub.tenon.asia {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		-Server
	}

	@trace method TRACE
	respond @trace 405

	request_body {
		max_size 16MB
	}

	# Coarse disk and backup state for the outside monitor, written by backup.sh status.
	handle /status.json {
		header Cache-Control "no-store"
		root * /var/lib/inthub-status
		file_server
	}

	reverse_proxy 127.0.0.1:7250
}
